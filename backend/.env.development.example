# ==================== Development Environment Configuration ====================
# Optimized for fast iteration and verbose debugging
# Copy this to .env and fill in your actual credentials

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=DEBUG  # Verbose logging for debugging

# Supabase (get from https://app.supabase.com/project/[project-id]/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
JWT_SECRET=your_jwt_secret_here

# Direct Postgres connection via asyncpg
# Use Direct connection (port 5432) for dev — Session pooler also works
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Telegram API (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Admin credentials
ADMIN_PHONE=+your_admin_phone_here
ADMIN_USERNAME=your_admin_username_here

# Encryption (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sentry (optional in dev)
SENTRY_DSN=  # Leave empty to disable

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Crawler API
CRAWLER_API_PORT=8001
CRAWLER_API_URL=http://127.0.0.1:8001

# Cookie settings
COOKIE_DOMAIN=  # Empty for localhost
COOKIE_SECURE=false  # No HTTPS in local dev

# ==================== Performance Tuning (Auto-configured for Dev) ====================
# Development environment automatically sets:
# - DB_POOL_MIN=1, DB_POOL_MAX=5 (smaller pool)
# - BATCH_SIZE=10, BATCH_TIMEOUT=1.0 (faster flush)
# - GAP_FILL_INTERVAL=300 (5 min for quick testing)
# - HISTORICAL_CRAWL_DAYS=3 (only 3 days)
# - SENTRY_TRACES_SAMPLE_RATE=1.0 (100% traces)
#
# You can override any of these by uncommenting and setting explicitly:
# DB_POOL_MIN=2
# DB_POOL_MAX=8
# BATCH_SIZE=20
# GAP_FILL_INTERVAL=600  # 10 minutes instead of 5
