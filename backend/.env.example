# Supabase (get from https://app.supabase.com/project/[project-id]/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
JWT_SECRET=your_jwt_secret_here

# Direct Postgres connection via asyncpg
# Get from: Supabase Dashboard > Settings > Database > Connection string
# CRITICAL: Use Session pooler (port 5432) or Direct connection, NOT Transaction pooler (6543)
# Transaction pooler breaks LISTEN/NOTIFY which is required for SSE realtime events
# Format: postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Telegram API (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Admin credentials
ADMIN_PHONE=+your_admin_phone_here
ADMIN_USERNAME=your_admin_username_here

# Encryption (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# JWT Token Expiration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://aaltohub.com

# Sentry
SENTRY_DSN=your_sentry_dsn_here

# Resend
RESEND_API_KEY=re_your_resend_api_key_here

# Crawler API (internal communication between backend and crawler process)
CRAWLER_API_PORT=8001
CRAWLER_API_SECRET=  # Defaults to JWT_SECRET if empty
CRAWLER_API_URL=http://127.0.0.1:8001

# Cookie settings (for httpOnly refresh token)
COOKIE_DOMAIN=  # Set to your domain in production (e.g. "aaltohub.com")
COOKIE_SECURE=false  # Set to true in production (requires HTTPS)

# Environment
ENVIRONMENT=development
