# Supabase (get from https://app.supabase.com/project/[project-id]/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
JWT_SECRET=your_jwt_secret_here

# Direct Postgres connection via asyncpg
# Get from: Supabase Dashboard > Settings > Database > Connection string
# CRITICAL: Use Session pooler (port 5432) or Direct connection, NOT Transaction pooler (6543)
# Transaction pooler breaks LISTEN/NOTIFY which is required for SSE realtime events
# Format: postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Telegram API (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Admin credentials
ADMIN_PHONE=+your_admin_phone_here
ADMIN_USERNAME=your_admin_username_here

# Encryption (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# JWT Token Expiration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://aaltohub.com

# Sentry
SENTRY_DSN=your_sentry_dsn_here

# Resend
RESEND_API_KEY=re_your_resend_api_key_here

# Anthropic (AI Classification - optional, enables AI features)
ANTHROPIC_API_KEY=

# Crawler API (internal communication between backend and crawler process)
CRAWLER_API_PORT=8001
CRAWLER_API_SECRET=  # Defaults to JWT_SECRET if empty
CRAWLER_API_URL=http://127.0.0.1:8001

# Cookie settings (for httpOnly refresh token)
COOKIE_DOMAIN=  # Set to your domain in production (e.g. "aaltohub.com")
COOKIE_SECURE=false  # Set to true in production (requires HTTPS)

# Environment
ENVIRONMENT=development  # development, staging, production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ==================== Performance Tuning (Optional - Uses sensible defaults) ====================
# These settings are auto-configured based on ENVIRONMENT, but can be overridden if needed.
# Development defaults: smaller batches, shorter intervals for fast iteration
# Production defaults: larger batches, longer intervals for efficiency

# Database Connection Pool
# DB_POOL_MIN=2  # Min connections (Dev: 1, Prod: 5)
# DB_POOL_MAX=10  # Max connections (Dev: 5, Prod: 20)

# Message Queue & Batch Processing
# MSG_QUEUE_MAXSIZE=10000  # Max queued messages before backpressure
# BATCH_SIZE=50  # Messages per batch INSERT (Dev: 10, Prod: 50)
# BATCH_TIMEOUT=2.0  # Seconds to wait before flushing partial batch (Dev: 1.0, Prod: 2.0)

# Historical Crawl
# HISTORICAL_CRAWL_DAYS=14  # Days to fetch during historical crawl (Dev: 3, Prod: 14)

# Gap-Fill (Message Recovery)
# GAP_FILL_INTERVAL=900  # Seconds between gap-fill runs (Dev: 300/5min, Prod: 900/15min)
# GAP_FILL_LOOKBACK_HOURS=3  # Hours to re-check for missed messages
# GAP_FILL_MAX_MESSAGES=2000  # Max messages per group during gap-fill

# Media Downloads
# MEDIA_CONCURRENCY=5  # Max parallel media downloads
# MEDIA_DOWNLOAD_BATCH=50  # Media items per chunk (for progress tracking)
# MEDIA_DOWNLOAD_TIMEOUT=30  # Seconds per media download

# Telegram Client Connection Settings
# TELEGRAM_REQUEST_RETRIES=5  # API request retry attempts
# TELEGRAM_CONNECTION_RETRIES=10  # Connection retry attempts
# TELEGRAM_RETRY_DELAY=2  # Seconds between retries
# TELEGRAM_TIMEOUT=120  # Seconds for Telegram API calls
# TELEGRAM_FLOOD_SLEEP_THRESHOLD=60  # Auto-wait if FloodWait ≤ this (seconds)

# Crawler Reconnection
# RECONNECT_DELAY=10  # Seconds to wait before reconnecting
# MAX_RECONNECT_ATTEMPTS=10  # Max reconnection attempts

# Caching
# ENABLED_CACHE_TTL=60  # Seconds for enabled groups cache
# ENABLED_CACHE_MAX_SIZE=1000  # Max cached entries before eviction

# Monitoring
# SENTRY_TRACES_SAMPLE_RATE=0.1  # Fraction of traces sent to Sentry (Dev: 1.0, Prod: 0.1)
