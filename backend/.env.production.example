# ==================== Production Environment Configuration ====================
# Optimized for efficiency and low overhead
# Copy this to .env on production server and fill in actual credentials

# Environment
ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO  # Less verbose for production

# Supabase (get from https://app.supabase.com/project/[project-id]/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
JWT_SECRET=your_jwt_secret_here  # Use a strong 64-char secret in production!

# Direct Postgres connection via asyncpg
# CRITICAL: Use Session pooler (port 5432), NOT Transaction pooler (6543)
# Transaction pooler breaks LISTEN/NOTIFY required for SSE
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Telegram API (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Admin credentials
ADMIN_PHONE=+your_admin_phone_here
ADMIN_USERNAME=your_admin_username_here

# Encryption
# ⚠️ WARNING: NEVER rotate this key after deployment!
# Changing it will invalidate all Telegram sessions
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://aaltohub.com,https://www.aaltohub.com

# Sentry (strongly recommended for production)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/123456

# Anthropic (optional, enables AI classification features)
ANTHROPIC_API_KEY=sk-ant-your-key

# Crawler API
CRAWLER_API_PORT=8001
CRAWLER_API_SECRET=  # Defaults to JWT_SECRET if empty
CRAWLER_API_URL=http://127.0.0.1:8001

# Cookie settings
COOKIE_DOMAIN=aaltohub.com  # Your production domain
COOKIE_SECURE=true  # Must be true in production (requires HTTPS)

# ==================== Performance Tuning (Auto-configured for Production) ====================
# Production environment automatically sets:
# - DB_POOL_MIN=5, DB_POOL_MAX=20 (larger pool for concurrency)
# - BATCH_SIZE=50, BATCH_TIMEOUT=2.0 (efficient batching)
# - GAP_FILL_INTERVAL=900 (15 min)
# - HISTORICAL_CRAWL_DAYS=14 (full 2 weeks)
# - SENTRY_TRACES_SAMPLE_RATE=0.1 (10% sampling to reduce overhead)
#
# You can override any of these for fine-tuning:
# DB_POOL_MAX=30  # Increase if handling very high traffic
# BATCH_SIZE=100  # Increase for higher throughput
# MEDIA_CONCURRENCY=10  # Increase for faster media downloads
