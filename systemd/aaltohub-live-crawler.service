[Unit]
Description=AaltoHub v2 Live Crawler (standalone process)
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AALTOHUBv2/backend
Environment="PATH=/home/ubuntu/AALTOHUBv2/backend/venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/ubuntu/AALTOHUBv2/backend/venv/bin/uvicorn crawler_main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aaltohub-live-crawler
RuntimeDirectory=aaltohub

# Restart limits (10분 내 5회 재시작 시 중단)
StartLimitIntervalSec=600
StartLimitBurst=5

# Graceful shutdown configuration
# Allow 60 seconds for queue drain and cleanup
TimeoutStopSec=60
# Send SIGTERM to main process first, SIGKILL to others
KillMode=mixed
KillSignal=SIGTERM

# Systemd watchdog (Phase 34)
# Python watchdog (app/watchdog.py) sends WATCHDOG=1 every 30s if healthy.
# If no heartbeat for 120s, systemd assumes process is hung and restarts it.
# Healthiness criteria: all clients connected + message queue <90% full
WatchdogSec=120

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/AALTOHUBv2

[Install]
WantedBy=multi-user.target
